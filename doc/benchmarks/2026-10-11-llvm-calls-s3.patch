+                                     (size_t)nargs);
+      else
+        result = llvm_call_fallback(function, rooted_args, (size_t)nargs);
+      llvm_gc_roots_leave(old_gcpro);
+    }
+  set_seclevel(old_seclevel);
+  seclevel_valid = old_seclevel_valid;
+  return result;
