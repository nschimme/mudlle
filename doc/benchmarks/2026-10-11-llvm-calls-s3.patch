+    }
+  else
+    {
+      value rooted_args[nargs ? (size_t)nargs : 1];
+      value *slots[nargs ? (size_t)nargs : 1];
+      struct gcpro roots[nargs ? (size_t)nargs : 1];
+      for (int64_t i = 0; i < nargs; ++i)
